# =============================================================================
# Autic — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Autic NEVER sends code, prompts, or secrets to external services
# unless explicitly configured to do so.

# =============================================================================
# REQUIRED — Provider API Keys (at least one)
# =============================================================================

# OpenRouter API key (recommended — access to 200+ models)
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# OpenAI API key (optional — direct OpenAI access)
# OPENAI_API_KEY=

# Anthropic API key (optional — direct Anthropic access)
# ANTHROPIC_API_KEY=

# Ollama base URL (optional — local model access)
# Default: http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# OPTIONAL — Runtime Configuration
# =============================================================================

# Maximum concurrent provider requests (default: 5)
# MAX_CONCURRENT_REQUESTS=5

# Default max tokens for provider responses (default: 4096)
# DEFAULT_MAX_TOKENS=4096

# Runtime log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Enable telemetry collection (opt-in, local-only, anonymized)
# TELEMETRY_ENABLED=false

# Telemetry data directory (default: ~/.autic/telemetry)
# TELEMETRY_DIR=~/.autic/telemetry

# =============================================================================
# OPTIONAL — Security Configuration
# =============================================================================

# Vault encryption key (auto-generated on first run if not provided)
# VAULT_KEY=

# Vault storage directory (default: ~/.autic/vault)
# VAULT_DIR=~/.autic/vault

# Maximum session age in hours before forced re-auth (default: 24)
# SESSION_MAX_AGE_HOURS=24

# =============================================================================
# OPTIONAL — Performance & Memory
# =============================================================================

# Maximum cache entries per system (default: 1000)
# MAX_CACHE_ENTRIES=1000

# Maximum memory usage in MB before triggering garbage collection (default: 512)
# MAX_MEMORY_MB=512

# Queue poll interval in ms (default: 100)
# QUEUE_POLL_INTERVAL_MS=100
